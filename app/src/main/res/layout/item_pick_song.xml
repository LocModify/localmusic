<?xml version="1.0" encoding="utf-8"?>
<!-- Một dòng trong màn hình "Thêm bài hát": tick tròn, ảnh bìa, tên + ca sĩ, thời lượng -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/pickRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:paddingHorizontal="10dp"
        android:paddingVertical="5dp">

        <ImageView
            android:id="@+id/ivPickCheck"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_check_circle_outline"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#9E9E9E" />

        <androidx.cardview.widget.CardView
            android:id="@+id/cardPickThumb"
            android:layout_width="50dp"
            android:layout_height="42dp"
            android:layout_marginStart="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/ivPickCheck"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/ivPickThumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:src="@drawable/bg_cover_default" />
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tvPickTag"
            app:layout_constraintStart_toEndOf="@id/cardPickThumb"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tvPickTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="marquee"
                android:fadingEdge="horizontal"
                android:fadingEdgeLength="14dp"
                android:fontFamily="sans-serif-medium"
                android:marqueeRepeatLimit="marquee_forever"
                android:requiresFadingEdge="horizontal"
                android:singleLine="true"
                android:textColor="#1F1B2E"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvPickArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="marquee"
                android:fadingEdge="horizontal"
                android:fadingEdgeLength="14dp"
                android:marqueeRepeatLimit="marquee_forever"
                android:requiresFadingEdge="horizontal"
                android:singleLine="true"
                android:textColor="#7A5BA8"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Thời lượng (hoặc chữ "Đã có" nếu bài đã nằm trong danh sách phát) -->
        <TextView
            android:id="@+id/tvPickTag"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:background="@drawable/qs_duration_pill"
            android:gravity="center"
            android:paddingHorizontal="9dp"
            android:text="00:00"
            android:textColor="#5B4B8A"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
