<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="4dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/itemContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_q_glass_card"
        android:minHeight="64dp"
        android:paddingStart="10dp"
        android:paddingTop="7dp"
        android:paddingEnd="4dp"
        android:paddingBottom="7dp">

        <!-- Vòng tròn chọn (chế độ chọn nhiều) - cùng vị trí với số thứ tự -->
        <ImageView
            android:id="@+id/ivSelectCheckbox"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="4dp"
            android:src="@drawable/ic_check_circle_outline"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#9E9E9E" />

        <!-- Số thứ tự trong vòng tròn -->
        <TextView
            android:id="@+id/tvIndex"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_q_index_circle"
            android:gravity="center"
            android:text="1"
            android:textColor="#6D28D9"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.cardview.widget.CardView
            android:id="@+id/cardThumbnail"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="10dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/tvIndex"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/ivQueueThumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/bg_cover_default" />
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tvDuration"
            app:layout_constraintStart_toEndOf="@id/cardThumbnail"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tvQueueItemTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#1F1B2E"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvQueueItemArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#7A5BA8"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Không còn dùng trong danh sách mới (bài đang phát nằm ở thẻ ghim trên cùng) -->
        <ImageView
            android:id="@+id/ivPlayingIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_graphic_eq"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tvDuration"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#7C3AED" />

        <TextView
            android:id="@+id/tvDuration"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:background="@drawable/bg_q_duration_pill"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="00:00"
            android:textColor="#5B21B6"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnQueueMore"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/btnQueueMore"
            android:layout_width="34dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="5dp"
            android:src="@drawable/ic_more_vert"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#6D28D9" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
