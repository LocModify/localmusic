<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="12dp"
    android:background="?attr/selectableItemBackground">

    <!-- Thu nhỏ ảnh bìa từ 56dp xuống 52dp cho thanh thoát -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardCover"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/bg_light"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/divider">

        <ImageView
            android:id="@+id/ivCover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_cover_default" />
    </androidx.cardview.widget.CardView>

    <!-- Giảm size chữ từ 16sp xuống 15sp -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:textColor="#1F1B2E"
        android:textSize="15sp"
        app:layout_constraintStart_toEndOf="@id/cardCover"
        app:layout_constraintEnd_toStartOf="@id/tvDuration"
        app:layout_constraintTop_toTopOf="@id/cardCover"
        app:layout_constraintBottom_toTopOf="@id/tvArtist"
        app:layout_constraintVertical_chainStyle="packed"
        tools:text="Tên bài hát" />

    <!-- Giảm size chữ từ 13sp xuống 12sp -->
    <TextView
        android:id="@+id/tvArtist"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif"
        android:maxLines="1"
        android:textColor="#8E8AA0"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="@id/tvTitle"
        app:layout_constraintEnd_toEndOf="@id/tvTitle"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintBottom_toBottomOf="@id/cardCover"
        tools:text="Ca sĩ" />

    <TextView
        android:id="@+id/tvDuration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:fontFamily="sans-serif"
        android:textColor="#6B6880"
        android:textSize="12sp"
        app:layout_constraintEnd_toStartOf="@id/btnMore"
        app:layout_constraintTop_toTopOf="@id/cardCover"
        app:layout_constraintBottom_toBottomOf="@id/cardCover"
        tools:text="03:24" />

    <ImageView
        android:id="@+id/btnMore"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="4dp"
        android:src="@drawable/ic_more_vert"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/cardCover"
        app:layout_constraintBottom_toBottomOf="@id/cardCover" />

    <!-- Vòng tròn chọn (chế độ chọn nhiều) - nằm đúng chỗ nút ba chấm -->
    <ImageView
        android:id="@+id/ivSelect"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:src="@drawable/ic_check_circle_outline"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/cardCover"
        app:layout_constraintEnd_toEndOf="@id/btnMore"
        app:layout_constraintStart_toStartOf="@id/btnMore"
        app:layout_constraintTop_toTopOf="@id/cardCover"
        app:tint="#9E9E9E" />

    <View
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginEnd="8dp"
        android:background="#EDE9F6"
        app:layout_constraintStart_toStartOf="@id/tvTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>