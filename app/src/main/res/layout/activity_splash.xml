<?xml version="1.0" encoding="utf-8"?>
<!-- Màn hình chờ: nền bụi sao + logo Lunar Music (animation) + chữ Lunar Music -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Bụi sao lấp lánh, trôi chậm -->
    <com.ztrongz.localmusic.StarFieldView
        android:id="@+id/splashStars"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Quầng sáng tím phía sau (thở nhẹ bằng độ sáng, không phóng to thu nhỏ) -->
    <View
        android:id="@+id/splashBackGlow"
        android:layout_width="420dp"
        android:layout_height="420dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_splash_glow" />

    <!-- Khối logo + chữ (xếp dọc). Các id bên trong giống header để LunarLogoLayout tự chạy animation -->
    <com.ztrongz.localmusic.LunarLogoLayout
        android:id="@+id/splashLogoGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- Khung logo 240x150dp: vòng sau -> quầng sáng -> trăng -> nốt -> vòng trước -> sao -->
        <FrameLayout
            android:id="@+id/splashLogoFrame"
            android:layout_width="240dp"
            android:layout_height="150dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <com.ztrongz.localmusic.OrbitRingView
                android:id="@+id/ringBack"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:tag="back" />

            <ImageView
                android:id="@+id/ivLunarGlow"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0.12"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_moon"
                app:tint="#8B5CF6" />

            <ImageView
                android:id="@+id/ivLunarMoon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_moon" />

            <ImageView
                android:id="@+id/ivLunarNote"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_note" />

            <com.ztrongz.localmusic.OrbitRingView
                android:id="@+id/ringFront"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:tag="front" />

            <ImageView
                android:id="@+id/ivSparkle1"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="205dp"
                android:layout_marginTop="5dp"
                android:alpha="0"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_logo_sparkle" />

            <ImageView
                android:id="@+id/ivSparkle2"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_marginStart="8dp"
                android:layout_marginTop="60dp"
                android:alpha="0"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_logo_sparkle" />

            <ImageView
                android:id="@+id/ivSparkle3"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="183dp"
                android:layout_marginTop="125dp"
                android:alpha="0"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_logo_sparkle" />
        </FrameLayout>

        <!-- Chữ Lunar Music + quầng sáng + tia sáng chạy theo mép khi chữ hiện ra -->
        <FrameLayout
            android:id="@+id/splashWordFrame"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <ImageView
                android:id="@+id/ivWordGlow"
                android:layout_width="220dp"
                android:layout_height="98dp"
                android:alpha="0.3"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_word_glow" />

            <ImageView
                android:id="@+id/ivWord"
                android:layout_width="220dp"
                android:layout_height="98dp"
                android:contentDescription="Lunar Music"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_word" />

            <ImageView
                android:id="@+id/splashWipeSpark"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="-17dp"
                android:alpha="0"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_logo_sparkle" />
        </FrameLayout>
    </com.ztrongz.localmusic.LunarLogoLayout>
</FrameLayout>
