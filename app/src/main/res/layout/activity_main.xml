<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_header">

    <!-- HEADER -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- LOGO + CHỮ "Lunar Music": trăng đứng yên, vòng quay quanh trăng, nốt nhạc + sao chuyển động -->
        <com.ztrongz.localmusic.LunarLogoLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Khung logo 96x60dp, các lớp xếp từ dưới lên: vòng sau -> quầng sáng -> trăng -> nốt -> vòng trước -> sao -->
            <FrameLayout
                android:layout_width="96dp"
                android:layout_height="60dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <com.ztrongz.localmusic.OrbitRingView
                    android:id="@+id/ringBack"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:tag="back" />

                <ImageView
                    android:id="@+id/ivLunarGlow"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:alpha="0.12"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/logo_moon"
                    app:tint="#8B5CF6" />

                <ImageView
                    android:id="@+id/ivLunarMoon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/logo_moon" />

                <ImageView
                    android:id="@+id/ivLunarNote"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/logo_note" />

                <com.ztrongz.localmusic.OrbitRingView
                    android:id="@+id/ringFront"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:tag="front" />

                <ImageView
                    android:id="@+id/ivSparkle1"
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:layout_marginStart="82dp"
                    android:layout_marginTop="2dp"
                    android:alpha="0"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_logo_sparkle" />

                <ImageView
                    android:id="@+id/ivSparkle2"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginStart="3dp"
                    android:layout_marginTop="24dp"
                    android:alpha="0"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_logo_sparkle" />

                <ImageView
                    android:id="@+id/ivSparkle3"
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:layout_marginStart="73dp"
                    android:layout_marginTop="50dp"
                    android:alpha="0"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_logo_sparkle" />
            </FrameLayout>

            <!-- Chữ Lunar Music (ảnh chữ theo đúng logo) + quầng sáng phía sau -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <ImageView
                    android:id="@+id/ivWordGlow"
                    android:layout_width="121dp"
                    android:layout_height="54dp"
                    android:alpha="0.3"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/logo_word_glow" />

                <ImageView
                    android:id="@+id/ivWord"
                    android:layout_width="121dp"
                    android:layout_height="54dp"
                    android:contentDescription="Lunar Music"
                    android:scaleType="fitCenter"
                    android:src="@drawable/logo_word" />
            </FrameLayout>
        </com.ztrongz.localmusic.LunarLogoLayout>


        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <ImageButton
                android:id="@+id/btnAdd"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_btn_add"
                android:src="@drawable/ic_add_purple"
                app:tint="@null"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_sparkles"
                android:translationX="8dp"
                android:translationY="-6dp"
                app:layout_constraintEnd_toEndOf="@id/btnAdd"
                app:layout_constraintTop_toTopOf="@id/btnAdd" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>

    <!-- SEARCH BAR -->
    <LinearLayout
        android:id="@+id/searchBar"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_search"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@id/headerLayout">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_search"
            app:tint="#B45CFF" />

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:background="@null"
            android:hint="Tìm kiếm bài hát..."
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/text_black"
            android:textColorHint="#A09CAB"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- CATEGORIES -->
    <LinearLayout
        android:id="@+id/categoriesLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_category_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="4dp"
        app:layout_constraintTop_toBottomOf="@id/searchBar">

        <TextView
            android:id="@+id/chipAll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_category_active"
            android:gravity="center"
            android:maxLines="1"
            android:paddingHorizontal="4dp"
            android:paddingVertical="9dp"
            android:text="Tất cả"
            android:textColor="@color/white"
            android:textSize="13sp"
            app:autoSizeMaxTextSize="13sp"
            app:autoSizeMinTextSize="10sp"
            app:autoSizeStepGranularity="1sp"
            app:autoSizeTextType="uniform" />

        <TextView
            android:id="@+id/chipFav"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_category_inactive"
            android:gravity="center"
            android:maxLines="1"
            android:paddingHorizontal="4dp"
            android:paddingVertical="9dp"
            android:text="Yêu thích"
            android:textColor="@color/text_black"
            android:textSize="13sp"
            app:autoSizeMaxTextSize="13sp"
            app:autoSizeMinTextSize="10sp"
            app:autoSizeStepGranularity="1sp"
            app:autoSizeTextType="uniform" />

        <TextView
            android:id="@+id/chipFolder"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_category_inactive"
            android:gravity="center"
            android:maxLines="1"
            android:paddingHorizontal="4dp"
            android:paddingVertical="9dp"
            android:text="Thư mục"
            android:textColor="@color/text_black"
            android:textSize="13sp"
            app:autoSizeMaxTextSize="13sp"
            app:autoSizeMinTextSize="10sp"
            app:autoSizeStepGranularity="1sp"
            app:autoSizeTextType="uniform" />

        <TextView
            android:id="@+id/chipRecent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_category_inactive"
            android:gravity="center"
            android:maxLines="1"
            android:paddingHorizontal="4dp"
            android:paddingVertical="9dp"
            android:text="Gần đây"
            android:textColor="@color/text_black"
            android:textSize="13sp"
            app:autoSizeMaxTextSize="13sp"
            app:autoSizeMinTextSize="10sp"
            app:autoSizeStepGranularity="1sp"
            app:autoSizeTextType="uniform" />
    </LinearLayout>

    <!-- THANH QUAY LẠI (chỉ hiện khi đang mở bên trong 1 thư mục) -->
    <LinearLayout
        android:id="@+id/folderBackBar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/categoriesLayout">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_back" />

        <TextView
            android:id="@+id/tvFolderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="#1F1B2E"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- RECYCLERVIEW -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toTopOf="@+id/miniPlayerLayout"
        app:layout_constraintTop_toBottomOf="@id/folderBackBar" />

    <!-- MINI PLAYER -->
    <LinearLayout
        android:id="@+id/miniPlayerLayout"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="14dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_mini_player"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="10dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomNav">

        <androidx.cardview.widget.CardView
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:cardBackgroundColor="@color/bg_light"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/ivMiniCover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/bg_cover_default" />
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <com.ztrongz.localmusic.MarqueeTextView
                android:id="@+id/tvNowPlaying"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Chưa phát bài nào"
                android:textColor="@color/text_black"
                android:textSize="13sp" />

            <com.ztrongz.localmusic.MarqueeTextView
                android:id="@+id/tvMiniArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="Local"
                android:textColor="#7C7894"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnPrev"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_prev"
            app:tint="#9A3CE8" />

        <ImageView
            android:id="@+id/btnPlayPause"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginHorizontal="6dp"
            android:background="@drawable/bg_button_purple"
            android:elevation="2dp"
            android:padding="10dp"
            android:src="@drawable/ic_play"
            app:tint="@color/white" />

        <ImageView
            android:id="@+id/btnNext"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_next"
            app:tint="#9A3CE8" />
    </LinearLayout>

    <!-- BOTTOM NAV -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:background="@color/white"
        android:elevation="10dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableTop="@drawable/ic_nav_home"
                android:drawablePadding="2dp"
                android:gravity="center"
                android:text="Trang chủ"
                android:textColor="@color/purple_primary"
                android:textSize="11sp"
                android:textStyle="bold"
                app:drawableTint="@color/purple_primary" />

            <View
                android:layout_width="24dp"
                android:layout_height="3dp"
                android:layout_marginTop="4dp"
                android:background="@color/purple_primary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableTop="@drawable/ic_nav_library"
                android:drawablePadding="2dp"
                android:gravity="center"
                android:text="Thư viện"
                android:textColor="#6B6880"
                android:textSize="11sp"
                app:drawableTint="#6B6880" />

            <View
                android:layout_width="24dp"
                android:layout_height="3dp"
                android:layout_marginTop="4dp"
                android:visibility="invisible" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableTop="@drawable/ic_nav_settings"
                android:drawablePadding="2dp"
                android:gravity="center"
                android:text="Cài đặt"
                android:textColor="#6B6880"
                android:textSize="11sp"
                app:drawableTint="#6B6880" />

            <View
                android:layout_width="24dp"
                android:layout_height="3dp"
                android:layout_marginTop="4dp"
                android:visibility="invisible" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>