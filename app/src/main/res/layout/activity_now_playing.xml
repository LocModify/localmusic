<?xml version="1.0" encoding="utf-8"?>
<com.ztrongz.localmusic.SwipeableConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".NowPlayingActivity">

    <!-- Lớp nền mờ -->
    <View
        android:id="@+id/bg_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_now_playing" />

    <!-- Container chứa toàn bộ nội dung -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- TOP BAR -->
        <ImageView
            android:id="@+id/btnMinimize"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_margin="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_down"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/btnPlaylistTop"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="20dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_playlist"
            app:layout_constraintBottom_toBottomOf="@+id/btnMinimize"
            app:layout_constraintEnd_toStartOf="@+id/btnMoreTop"
            app:layout_constraintTop_toTopOf="@+id/btnMinimize" />

        <ImageView
            android:id="@+id/btnMoreTop"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_more_vert"
            app:layout_constraintBottom_toBottomOf="@+id/btnMinimize"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/btnMinimize" />

        <!-- VÙNG CHỨA ẢNH BÌA VÀ HIỆU ỨNG (GLOW, ORBIT, NOTES) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/albumArtContainer"
            android:layout_width="340dp"
            android:layout_height="340dp"
            android:layout_marginTop="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnMinimize">

            <!-- Vầng sáng lớn phía sau (vGlow) -->
            <View
                android:id="@+id/vGlow"
                android:layout_width="320dp"
                android:layout_height="320dp"
                android:background="@drawable/bg_play_glow"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Quỹ đạo 1 (vOrbit1) -->
            <View
                android:id="@+id/vOrbit1"
                android:layout_width="340dp"
                android:layout_height="160dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_orbit"
                android:rotation="-15"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Quỹ đạo 2 (vOrbit2) -->
            <View
                android:id="@+id/vOrbit2"
                android:layout_width="340dp"
                android:layout_height="160dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_orbit"
                android:rotation="15"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Ảnh bìa chính -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardAlbumArt"
                android:layout_width="260dp"
                android:layout_height="260dp"
                app:cardBackgroundColor="#40FFFFFF"
                app:cardCornerRadius="130dp"
                app:cardElevation="10dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardCoverInner"
                    android:layout_width="240dp"
                    android:layout_height="240dp"
                    android:layout_gravity="center"
                    app:cardCornerRadius="120dp"
                    app:cardElevation="0dp">

                    <ImageView
                        android:id="@+id/imgAlbumArt"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/bg_cover_default" />
                </androidx.cardview.widget.CardView>
            </androidx.cardview.widget.CardView>

            <!-- Các nốt nhạc bay (note1 -> note4) -->
            <ImageView
                android:id="@+id/note1"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_chip_music"
                app:tint="#B45CFF"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintVertical_bias="0.2"
                android:layout_marginStart="10dp" />

            <ImageView
                android:id="@+id/note2"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_chip_music"
                app:tint="#DCC6FF"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintVertical_bias="0.3"
                android:layout_marginEnd="20dp" />

            <ImageView
                android:id="@+id/note3"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_chip_music"
                app:tint="#DCC6FF"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintVertical_bias="0.7"
                android:layout_marginStart="30dp" />

            <ImageView
                android:id="@+id/note4"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_chip_music"
                app:tint="#B45CFF"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintVertical_bias="0.6"
                android:layout_marginEnd="10dp" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- TÊN BÀI HÁT & NGHỆ SĨ -->
        <TextView
            android:id="@+id/txtSongTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="16dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Dreaming"
            android:textColor="#111111"
            android:textSize="26sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/btnFavoriteTop"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/albumArtContainer" />

        <TextView
            android:id="@+id/txtArtist"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="16dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Unknown Artist"
            android:textColor="#555555"
            android:textSize="15sp"
            app:layout_constraintEnd_toStartOf="@+id/btnFavoriteTop"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txtSongTitle" />

        <ImageView
            android:id="@+id/btnFavoriteTop"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/bg_icon_circle_light"
            android:padding="10dp"
            android:src="@drawable/ic_heart_outline"
            app:tint="#B45CFF"
            app:layout_constraintBottom_toBottomOf="@+id/txtArtist"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/txtSongTitle" />

        <!-- THANH TIẾN TRÌNH (SEEK BAR) -->
        <TextView
            android:id="@+id/txtCurrentTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="20dp"
            android:text="00:00"
            android:textColor="#333333"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txtArtist" />

        <TextView
            android:id="@+id/txtTotalTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="24dp"
            android:text="00:00"
            android:textColor="#333333"
            android:textSize="13sp"
            app:layout_constraintBottom_toBottomOf="@+id/txtCurrentTime"
            app:layout_constraintEnd_toEndOf="parent" />

        <SeekBar
            android:id="@+id/seekBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:progressTint="#B45CFF"
            android:thumbTint="#B45CFF"
            app:layout_constraintBottom_toBottomOf="@+id/txtCurrentTime"
            app:layout_constraintEnd_toStartOf="@+id/txtTotalTime"
            app:layout_constraintStart_toEndOf="@+id/txtCurrentTime"
            app:layout_constraintTop_toTopOf="@+id/txtCurrentTime" />

        <!-- CỤM NÚT ĐIỀU KHIỂN -->
        <LinearLayout
            android:id="@+id/controlsLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            app:layout_constraintTop_toBottomOf="@+id/seekBar">

            <ImageView
                android:id="@+id/btnShuffle"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="4dp"
                android:src="@drawable/ic_shuffle" />

            <Space android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />

            <ImageView
                android:id="@+id/btnPrevious"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_prev" />

            <Space android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <!-- Lớp hào quang tròn -->
                <View
                    android:id="@+id/vPlayGlow"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_play_glow" />

                <androidx.cardview.widget.CardView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center"
                    app:cardBackgroundColor="#B45CFF"
                    app:cardCornerRadius="32dp"
                    app:cardElevation="0dp">

                    <ImageView
                        android:id="@+id/btnPlayPause"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_play" />
                </androidx.cardview.widget.CardView>
            </FrameLayout>

            <Space android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />

            <ImageView
                android:id="@+id/btnNext"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_next" />

            <Space android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />

            <ImageView
                android:id="@+id/btnRepeat"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="4dp"
                android:src="@drawable/ic_repeat" />
        </LinearLayout>

        <!-- HÀNG CHỨC NĂNG DƯỚI CÙNG -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            app:layout_constraintBottom_toBottomOf="parent">

            <Button
                android:id="@+id/btnFavoriteBottom"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_pill_button"
                android:drawableStart="@drawable/ic_heart_outline"
                android:drawablePadding="6dp"
                android:text="Yêu thích"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textColor="#333333"
                app:iconTint="#B45CFF" />

            <Button
                android:id="@+id/btnAddTo"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_pill_button"
                android:drawableStart="@drawable/ic_add_purple"
                android:drawablePadding="6dp"
                android:text="Thêm vào"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textColor="#333333" />

            <Button
                android:id="@+id/btnDownload"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_pill_button"
                android:drawableStart="@android:drawable/stat_sys_download"
                android:drawablePadding="6dp"
                android:text="Tải xuống"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textColor="#333333" />

            <Button
                android:id="@+id/btnInfo"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_weight="1"
                android:background="@drawable/bg_pill_button"
                android:drawableStart="@android:drawable/ic_menu_info_details"
                android:drawablePadding="6dp"
                android:text="Thông tin"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textColor="#333333" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.ztrongz.localmusic.SwipeableConstraintLayout>