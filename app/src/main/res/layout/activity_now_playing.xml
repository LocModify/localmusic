<?xml version="1.0" encoding="utf-8"?>
<com.ztrongz.localmusic.SwipeableConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    tools:context=".NowPlayingActivity">

    <!-- Background Mesh Gradient -->
    <View
        android:id="@+id/bg_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_now_playing" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- NỐT NHẠC BAY XUNG QUANH (Tạo chiều sâu) -->
        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="40dp"
            android:layout_marginTop="100dp"
            android:alpha="0.4"
            android:src="@drawable/ic_chip_music"
            android:rotation="-15"
            app:tint="#C9A5FF"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginTop="150dp"
            android:layout_marginEnd="30dp"
            android:alpha="0.5"
            android:src="@drawable/ic_chip_music"
            android:rotation="25"
            app:tint="#C9A5FF"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="20dp"
            android:alpha="0.4"
            android:src="@drawable/ic_chip_music"
            android:rotation="10"
            app:tint="#C9A5FF"
            app:layout_constraintBottom_toBottomOf="@+id/cardAlbumArt"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/cardAlbumArt" />

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="20dp"
            android:alpha="0.5"
            android:src="@drawable/ic_chip_music"
            android:rotation="-20"
            app:tint="#C9A5FF"
            app:layout_constraintBottom_toBottomOf="@+id/cardAlbumArt"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/cardAlbumArt" />

        <!-- 1. THANH TOP BAR -->
        <ImageView
            android:id="@+id/btnMinimize"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_margin="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_down"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#B45CFF" />

        <ImageView
            android:id="@+id/btnPlaylistTop"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="20dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_playlist"
            app:layout_constraintBottom_toBottomOf="@+id/btnMinimize"
            app:layout_constraintEnd_toStartOf="@+id/btnMoreTop"
            app:layout_constraintTop_toTopOf="@+id/btnMinimize"
            app:tint="#B45CFF" />

        <ImageView
            android:id="@+id/btnMoreTop"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_more_vert"
            app:layout_constraintBottom_toBottomOf="@+id/btnMinimize"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/btnMinimize"
            app:tint="#B45CFF" />

        <!-- 2. ẢNH BÌA LỚN + HIỆU ỨNG SÁNG RỰC RỠ -->
        <FrameLayout
            android:id="@+id/cardAlbumArt"
            android:layout_width="300dp"
            android:layout_height="300dp"
            android:layout_marginTop="20dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnMinimize">

            <!-- Hào quang phát sáng mạnh hơn -->
            <View
                android:id="@+id/vGlow"
                android:layout_width="360dp"
                android:layout_height="360dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_cover_glow" />

            <!-- Vòng quỹ đạo đậm hơn -->
            <View
                android:id="@+id/vOrbit1"
                android:layout_width="350dp"
                android:layout_height="170dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_orbit"
                android:rotation="20" />

            <View
                android:id="@+id/vOrbit2"
                android:layout_width="350dp"
                android:layout_height="200dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_orbit"
                android:rotation="-30" />

            <View
                android:layout_width="292dp"
                android:layout_height="292dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_cover_ring" />

            <androidx.cardview.widget.CardView
                android:id="@+id/cardCoverInner"
                android:layout_width="272dp"
                android:layout_height="272dp"
                android:layout_gravity="center"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="136dp"
                app:cardElevation="0dp">

                <ImageView
                    android:id="@+id/imgAlbumArt"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/bg_cover_default" />
            </androidx.cardview.widget.CardView>

            <ImageView
                android:id="@+id/note1"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="top|start"
                android:alpha="0.9"
                android:src="@drawable/ic_chip_music"
                android:translationX="-16dp"
                android:translationY="4dp"
                app:tint="#C9A5FF" />

            <ImageView
                android:id="@+id/note2"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="top|end"
                android:alpha="0.9"
                android:src="@drawable/ic_chip_music"
                android:translationX="14dp"
                android:translationY="-2dp"
                app:tint="#C9A5FF" />

            <ImageView
                android:id="@+id/note3"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="bottom|start"
                android:alpha="0.9"
                android:src="@drawable/ic_chip_music"
                android:translationX="-12dp"
                android:translationY="2dp"
                app:tint="#C9A5FF" />

            <ImageView
                android:id="@+id/note4"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="bottom|end"
                android:alpha="0.9"
                android:src="@drawable/ic_chip_music"
                android:translationX="12dp"
                android:translationY="-6dp"
                app:tint="#C9A5FF" />
        </FrameLayout>

        <!-- 3. TÊN BÀI HÁT & NGHỆ SĨ -->
        <com.ztrongz.localmusic.MarqueeTextView
            android:id="@+id/txtSongTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:paddingStart="60dp"
            android:paddingEnd="60dp"
            android:gravity="center"
            android:text="Dreaming"
            android:textColor="#111111"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cardAlbumArt" />

        <com.ztrongz.localmusic.MarqueeTextView
            android:id="@+id/txtArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:paddingStart="60dp"
            android:paddingEnd="60dp"
            android:gravity="center"
            android:text="Unknown Artist"
            android:textColor="#7A5BA8"
            android:textSize="15sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txtSongTitle" />

        <ImageView
            android:id="@+id/btnFavoriteTop"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_icon_circle_light"
            android:padding="10dp"
            android:src="@drawable/ic_heart_outline"
            app:layout_constraintBottom_toBottomOf="@+id/txtArtist"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/txtSongTitle" />

        <!-- 4. THANH TIẾN TRÌNH (SEEK BAR) -->
        <TextView
            android:id="@+id/txtCurrentTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="16dp"
            android:text="00:00"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.04"
            android:textColor="#4B3A94"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txtArtist" />

        <TextView
            android:id="@+id/txtTotalTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="24dp"
            android:text="00:00"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.04"
            android:textColor="#4B3A94"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="@+id/txtCurrentTime"
            app:layout_constraintEnd_toEndOf="parent" />

        <SeekBar
            android:id="@+id/seekBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:maxHeight="5dp"
            android:minHeight="5dp"
            android:progressDrawable="@drawable/seekbar_progress"
            android:splitTrack="false"
            android:thumb="@drawable/seekbar_thumb"
            app:layout_constraintBottom_toBottomOf="@+id/txtCurrentTime"
            app:layout_constraintEnd_toStartOf="@+id/txtTotalTime"
            app:layout_constraintStart_toEndOf="@+id/txtCurrentTime"
            app:layout_constraintTop_toTopOf="@+id/txtCurrentTime" />

        <!-- 5. CỤM NÚT ĐIỀU KHIỂN -->
        <LinearLayout
            android:id="@+id/controlsLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clipChildren="false" 
            android:clipToPadding="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            app:layout_constraintTop_toBottomOf="@+id/seekBar">

            <!-- NÚT SHUFFLE THEO THIẾT KẾ MỚI -->
            <ImageView
                android:id="@+id/btnShuffle"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_ctrl_square"
                android:padding="14dp"
                android:src="@drawable/ic_shuffle"
                app:tint="#9E9E9E" />

            <Space android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />

            <ImageView
                android:id="@+id/btnPrevious"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="8dp"
                android:src="@drawable/ic_np_prev"
                app:tint="#3B206F" />

            <Space android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />

            <FrameLayout
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <View
                    android:id="@+id/vPlayGlow"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_play_glow" />

                <ImageView
                    android:id="@+id/btnPlayPause"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_play_button"
                    android:padding="12dp"
                    android:src="@drawable/ic_np_play"
                    app:tint="#FFFFFF" />
            </FrameLayout>

            <Space android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />

            <ImageView
                android:id="@+id/btnNext"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="8dp"
                android:src="@drawable/ic_np_next"
                app:tint="#3B206F" />

            <Space android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />

            <!-- NÚT REPEAT THEO THIẾT KẾ MỚI -->
            <ImageView
                android:id="@+id/btnRepeat"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_ctrl_square"
                android:padding="14dp"
                android:src="@drawable/ic_repeat"
                app:tint="#9E9E9E" />
        </LinearLayout>

        <!-- 6. HÀNG CHỨC NĂNG DƯỚI CÙNG -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            app:layout_constraintBottom_toBottomOf="parent">

            <Button
                android:id="@+id/btnFavoriteBottom"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_pill_button"
                android:drawableStart="@drawable/ic_heart_outline"
                android:drawablePadding="6dp"
                android:text="Yêu thích"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textColor="#4A2A7A"
                app:drawableTint="#B45CFF" />

            <Button
                android:id="@+id/btnAddTo"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_pill_button"
                android:drawableStart="@drawable/ic_add_purple"
                android:drawablePadding="6dp"
                android:text="Thêm vào"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textColor="#4A2A7A" />

            <Button
                android:id="@+id/btnDownload"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_pill_button"
                android:drawableStart="@android:drawable/stat_sys_download"
                android:drawablePadding="6dp"
                android:text="Tải xuống"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textColor="#4A2A7A"
                app:drawableTint="#B45CFF" />

            <Button
                android:id="@+id/btnInfo"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_weight="1"
                android:background="@drawable/bg_pill_button"
                android:drawableStart="@android:drawable/ic_menu_info_details"
                android:drawablePadding="6dp"
                android:text="Thông tin"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textColor="#4A2A7A"
                app:drawableTint="#B45CFF" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.ztrongz.localmusic.SwipeableConstraintLayout>