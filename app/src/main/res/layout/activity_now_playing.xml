<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F4FF"
    tools:context=".NowPlayingActivity">

    <!-- 1. THANH TOP BAR -->
    <ImageView
        android:id="@+id/btnMinimize"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_margin="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_menu_sort_by_size"
        app:tint="#5E35B1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/btnPlaylistTop"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="16dp"
        android:src="@android:drawable/ic_menu_view"
        app:tint="#5E35B1"
        app:layout_constraintBottom_toBottomOf="@+id/btnMinimize"
        app:layout_constraintEnd_toStartOf="@+id/btnMoreTop"
        app:layout_constraintTop_toTopOf="@+id/btnMinimize" />

    <ImageView
        android:id="@+id/btnMoreTop"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="16dp"
        android:src="@android:drawable/ic_menu_more"
        app:tint="#5E35B1"
        app:layout_constraintBottom_toBottomOf="@+id/btnMinimize"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/btnMinimize" />

    <!-- 2. ẢNH BÌA LỚN -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardAlbumArt"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_marginTop="40dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="150dp"
        app:cardElevation="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnMinimize">

        <ImageView
            android:id="@+id/imgAlbumArt"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_gallery" />
    </androidx.cardview.widget.CardView>

    <!-- 3. TÊN BÀI HÁT & NGHỆ SĨ -->
    <TextView
        android:id="@+id/txtSongTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="Dreaming"
        android:textColor="#000000"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cardAlbumArt" />

    <TextView
        android:id="@+id/txtArtist"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Unknown Artist"
        android:textColor="#555555"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtSongTitle" />

    <ImageView
        android:id="@+id/btnFavoriteTop"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="32dp"
        android:background="@drawable/bg_circle_purple"
        android:padding="8dp"
        android:src="@android:drawable/ic_menu_myplaces"
        app:tint="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="@+id/txtArtist"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/txtSongTitle" />

    <!-- 4. THANH TIẾN TRÌNH (SEEK BAR) -->
    <TextView
        android:id="@+id/txtCurrentTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="30dp"
        android:text="00:45"
        android:textColor="#333333"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtArtist" />

    <TextView
        android:id="@+id/txtTotalTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="24dp"
        android:text="03:24"
        android:textColor="#333333"
        app:layout_constraintBottom_toBottomOf="@+id/txtCurrentTime"
        app:layout_constraintEnd_toEndOf="parent" />

    <SeekBar
        android:id="@+id/seekBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:progressTint="#8B3DFF"
        android:thumbTint="#8B3DFF"
        app:layout_constraintBottom_toBottomOf="@+id/txtCurrentTime"
        app:layout_constraintEnd_toStartOf="@+id/txtTotalTime"
        app:layout_constraintStart_toEndOf="@+id/txtCurrentTime"
        app:layout_constraintTop_toTopOf="@+id/txtCurrentTime" />

    <!-- 5. CỤM NÚT ĐIỀU KHIỂN -->
    <LinearLayout
        android:id="@+id/controlsLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        app:layout_constraintTop_toBottomOf="@+id/seekBar">

        <ImageView
            android:id="@+id/btnShuffle"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@android:drawable/ic_menu_sort_alphabetically"
            app:tint="#5E35B1" />

        <Space android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />

        <ImageView
            android:id="@+id/btnPrevious"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_media_previous"
            app:tint="#333333" />

        <Space android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />

        <androidx.cardview.widget.CardView
            android:layout_width="80dp"
            android:layout_height="80dp"
            app:cardBackgroundColor="#8B3DFF"
            app:cardCornerRadius="40dp"
            app:cardElevation="10dp">
            <ImageView
                android:id="@+id/btnPlayPause"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_media_pause"
                app:tint="#FFFFFF" />
        </androidx.cardview.widget.CardView>

        <Space android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />

        <ImageView
            android:id="@+id/btnNext"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_media_next"
            app:tint="#333333" />

        <Space android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />

        <ImageView
            android:id="@+id/btnRepeat"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@android:drawable/ic_menu_rotate"
            app:tint="#5E35B1" />
    </LinearLayout>

    <!-- 6. HÀNG CHỨC NĂNG DƯỚI CÙNG -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="30dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/btnFavoriteBottom"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_pill_button"
            android:drawableStart="@android:drawable/ic_menu_myplaces"
            android:drawablePadding="8dp"
            android:text="Yêu thích"
            android:textAllCaps="false"
            android:textColor="#333333"
            app:iconTint="#5E35B1" />

        <Button
            android:id="@+id/btnAddTo"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_pill_button"
            android:drawableStart="@android:drawable/ic_menu_add"
            android:drawablePadding="8dp"
            android:text="Thêm vào"
            android:textAllCaps="false"
            android:textColor="#333333" />

        <Button
            android:id="@+id/btnInfo"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pill_button"
            android:drawableStart="@android:drawable/ic_menu_info_details"
            android:drawablePadding="8dp"
            android:text="Thông tin"
            android:textAllCaps="false"
            android:textColor="#333333" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>