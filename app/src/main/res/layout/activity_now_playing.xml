<?xml version="1.0" encoding="utf-8"?>
<com.ztrongz.localmusic.SwipeableConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    tools:context=".NowPlayingActivity">

    <!-- Lớp nền (trắng + lụa/sóng tím) -->
    <View
        android:id="@+id/bg_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_now_playing" />

    <!-- Container chứa toàn bộ nội dung -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- 1. THANH TOP BAR -->
        <ImageView
            android:id="@+id/btnMinimize"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_margin="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_down"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#B45CFF" />

        <ImageView
            android:id="@+id/btnPlaylistTop"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="20dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_playlist"
            app:layout_constraintBottom_toBottomOf="@+id/btnMinimize"
            app:layout_constraintEnd_toStartOf="@+id/btnMoreTop"
            app:layout_constraintTop_toTopOf="@+id/btnMinimize"
            app:tint="#B45CFF" />

        <ImageView
            android:id="@+id/btnMoreTop"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_more_vert"
            app:layout_constraintBottom_toBottomOf="@+id/btnMinimize"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/btnMinimize"
            app:tint="#B45CFF" />

        <!-- 2. ĐĨA NHẠC + HIỆU ỨNG (vầng sáng, quỹ đạo, cột sóng, nốt nhạc) -->
        <FrameLayout
            android:id="@+id/cardAlbumArt"
            android:layout_width="300dp"
            android:layout_height="300dp"
            android:layout_marginTop="20dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnMinimize">

            <!-- Vầng sáng tím sát vành trắng -->
            <View
                android:id="@+id/vGlow"
                android:layout_width="300dp"
                android:layout_height="300dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_cover_glow" />

            <!-- 2 quỹ đạo elip mảnh (quay ngược chiều nhau trong code) -->
            <View
                android:id="@+id/vOrbit1"
                android:layout_width="340dp"
                android:layout_height="170dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_orbit"
                android:rotation="-22" />

            <View
                android:id="@+id/vOrbit2"
                android:layout_width="320dp"
                android:layout_height="140dp"
                android:layout_gravity="center"
                android:alpha="0.6"
                android:background="@drawable/bg_orbit"
                android:rotation="30" />

            <!-- Cột sóng nhạc ở góc dưới phải -->
            <ImageView
                android:layout_width="120dp"
                android:layout_height="80dp"
                android:layout_gravity="bottom|end"
                android:src="@drawable/ic_wave_bars"
                android:translationX="30dp"
                android:translationY="14dp" />

            <!-- Vành trắng sát ảnh -->
            <View
                android:layout_width="254dp"
                android:layout_height="254dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_cover_ring" />

            <!-- Ảnh bìa tròn (xoay khi đang phát) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardCoverInner"
                android:layout_width="244dp"
                android:layout_height="244dp"
                android:layout_gravity="center"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="122dp"
                app:cardElevation="0dp">

                <ImageView
                    android:id="@+id/imgAlbumArt"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/bg_cover_default" />
            </androidx.cardview.widget.CardView>

            <!-- 4 nốt nhạc lớn (bay lên xuống trong code) -->
            <ImageView
                android:id="@+id/note1"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="top|start"
                android:src="@drawable/ic_note_double"
                android:translationX="-14dp"
                android:translationY="2dp"
                app:tint="#BE9BFF" />

            <ImageView
                android:id="@+id/note2"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="top|end"
                android:src="@drawable/ic_note_double"
                android:translationX="16dp"
                android:translationY="-4dp"
                app:tint="#BE9BFF" />

            <ImageView
                android:id="@+id/note3"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="bottom|start"
                android:src="@drawable/ic_note_double"
                android:translationX="-8dp"
                android:translationY="4dp"
                app:tint="#BE9BFF" />

            <ImageView
                android:id="@+id/note4"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="bottom|end"
                android:src="@drawable/ic_chip_music"
                android:translationX="-34dp"
                android:translationY="10dp"
                app:tint="#BE9BFF" />

            <!-- 4 nốt nhạc nhỏ trang trí (đứng yên) -->
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="start|center_vertical"
                android:alpha="0.85"
                android:src="@drawable/ic_chip_music"
                android:translationX="-26dp"
                android:translationY="-30dp"
                app:tint="#BE9BFF" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="end|center_vertical"
                android:alpha="0.85"
                android:src="@drawable/ic_chip_music"
                android:translationX="28dp"
                android:translationY="-20dp"
                app:tint="#BE9BFF" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="top|end"
                android:alpha="0.85"
                android:src="@drawable/ic_chip_music"
                android:translationX="-14dp"
                android:translationY="26dp"
                app:tint="#BE9BFF" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="bottom|start"
                android:alpha="0.85"
                android:src="@drawable/ic_chip_music"
                android:translationX="38dp"
                android:translationY="12dp"
                app:tint="#BE9BFF" />
        </FrameLayout>

        <!-- 3. TÊN BÀI HÁT & NGHỆ SĨ: căn giữa màn hình (chừa 2 bên bằng nhau 76dp) -->
        <com.ztrongz.localmusic.MarqueeTextView
            android:id="@+id/txtSongTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginStart="76dp"
            android:layout_marginEnd="76dp"
            android:gravity="center_horizontal"
            android:text="Dreaming"
            android:textColor="#111111"
            android:textSize="26sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cardAlbumArt" />

        <com.ztrongz.localmusic.MarqueeTextView
            android:id="@+id/txtArtist"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginStart="76dp"
            android:layout_marginEnd="76dp"
            android:gravity="center_horizontal"
            android:text="Unknown Artist"
            android:textColor="#7A5BA8"
            android:textSize="15sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txtSongTitle" />

        <ImageView
            android:id="@+id/btnFavoriteTop"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/bg_icon_circle_light"
            android:padding="10dp"
            android:src="@drawable/ic_heart_outline"
            app:layout_constraintBottom_toBottomOf="@+id/txtArtist"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/txtSongTitle" />

        <!-- 4. THANH TIẾN TRÌNH (SEEK BAR) -->
        <TextView
            android:id="@+id/txtCurrentTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="20dp"
            android:text="00:00"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.04"
            android:textColor="#4B3A94"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txtArtist" />

        <TextView
            android:id="@+id/txtTotalTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="24dp"
            android:text="00:00"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.04"
            android:textColor="#4B3A94"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="@+id/txtCurrentTime"
            app:layout_constraintEnd_toEndOf="parent" />

        <SeekBar
            android:id="@+id/seekBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:maxHeight="5dp"
            android:minHeight="5dp"
            android:progressDrawable="@drawable/seekbar_progress"
            android:splitTrack="false"
            android:thumb="@drawable/seekbar_thumb"
            app:layout_constraintBottom_toBottomOf="@+id/txtCurrentTime"
            app:layout_constraintEnd_toStartOf="@+id/txtTotalTime"
            app:layout_constraintStart_toEndOf="@+id/txtCurrentTime"
            app:layout_constraintTop_toTopOf="@+id/txtCurrentTime" />

        <!-- 5. CỤM NÚT ĐIỀU KHIỂN -->
        <LinearLayout
            android:id="@+id/controlsLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clipChildren="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            app:layout_constraintTop_toBottomOf="@+id/seekBar">

            <ImageView
                android:id="@+id/btnShuffle"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_ctrl_square"
                android:padding="11dp"
                android:src="@drawable/ic_shuffle"
                app:tint="#7C3AED" />

            <Space android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />

            <ImageView
                android:id="@+id/btnPrevious"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="8dp"
                android:src="@drawable/ic_np_prev"
                app:tint="#4527A0" />

            <Space android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />

            <!-- Nút Play/Pause: cả vòng tím là nút bấm, kèm 1 hào quang nhỏ phía sau -->
            <FrameLayout
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:clipChildren="false">

                <View
                    android:id="@+id/vPlayGlow"
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_play_glow" />

                <ImageView
                    android:id="@+id/btnPlayPause"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_play_button"
                    android:padding="21dp"
                    android:src="@drawable/ic_np_play" />
            </FrameLayout>

            <Space android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />

            <ImageView
                android:id="@+id/btnNext"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="8dp"
                android:src="@drawable/ic_np_next"
                app:tint="#4527A0" />

            <Space android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />

            <ImageView
                android:id="@+id/btnRepeat"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_ctrl_square"
                android:padding="11dp"
                android:src="@drawable/ic_repeat"
                app:tint="#7C3AED" />
        </LinearLayout>

        <!-- 6. HÀNG CHỨC NĂNG DƯỚI CÙNG -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            app:layout_constraintBottom_toBottomOf="parent">

            <Button
                android:id="@+id/btnFavoriteBottom"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_pill_button"
                android:drawableStart="@drawable/ic_heart_outline"
                android:drawablePadding="6dp"
                android:text="Yêu thích"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textColor="#4A2A7A"
                app:drawableTint="#B45CFF" />

            <Button
                android:id="@+id/btnAddTo"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_pill_button"
                android:drawableStart="@drawable/ic_add_purple"
                android:drawablePadding="6dp"
                android:text="Thêm vào"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textColor="#4A2A7A" />

            <Button
                android:id="@+id/btnDownload"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_pill_button"
                android:drawableStart="@android:drawable/stat_sys_download"
                android:drawablePadding="6dp"
                android:text="Tải xuống"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textColor="#4A2A7A"
                app:drawableTint="#B45CFF" />

            <Button
                android:id="@+id/btnInfo"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_weight="1"
                android:background="@drawable/bg_pill_button"
                android:drawableStart="@android:drawable/ic_menu_info_details"
                android:drawablePadding="6dp"
                android:text="Thông tin"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textColor="#4A2A7A"
                app:drawableTint="#B45CFF" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.ztrongz.localmusic.SwipeableConstraintLayout>