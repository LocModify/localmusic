<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_bottom_sheet_rounded">

    <!-- Thanh kéo -->
    <View
        android:id="@+id/dragHandle"
        android:layout_width="48dp"
        android:layout_height="5dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_drag_handle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Tiêu đề -->
    <TextView
        android:id="@+id/tvPlaylistTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="18dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Danh sách phát"
        android:textColor="#1F1B2E"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@id/pillPlaying"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dragHandle" />

    <TextView
        android:id="@+id/tvPlaylistSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="0 bài hát • 0 phút"
        android:textColor="#7A5BA8"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="@id/tvPlaylistTitle"
        app:layout_constraintTop_toBottomOf="@id/tvPlaylistTitle" />

    <!-- Nhãn Đang phát -->
    <LinearLayout
        android:id="@+id/pillPlaying"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_pill_playing"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@id/tvPlaylistTitle"
        app:layout_constraintEnd_toStartOf="@id/btnAddSong"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@id/tvPlaylistTitle"
        app:layout_constraintTop_toTopOf="@id/tvPlaylistTitle">

        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/ic_np_play"
            app:tint="#7C3AED" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:maxLines="1"
            android:text="Đang phát"
            android:textColor="#7C3AED"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Nút thêm nhạc và tùy chọn -->
    <ImageView
        android:id="@+id/btnAddSong"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/bg_sheet_circle_btn"
        android:padding="9dp"
        android:src="@drawable/ic_add_music"
        app:layout_constraintBottom_toBottomOf="@id/tvPlaylistSubtitle"
        app:layout_constraintEnd_toStartOf="@id/btnMoreOptions"
        app:layout_constraintTop_toTopOf="@id/tvPlaylistTitle"
        app:tint="#7C3AED" />

    <ImageView
        android:id="@+id/btnMoreOptions"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_sheet_circle_btn"
        android:padding="9dp"
        android:src="@drawable/ic_more_horiz"
        app:layout_constraintBottom_toBottomOf="@id/tvPlaylistSubtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvPlaylistTitle"
        app:tint="#7C3AED" />

    <!-- Danh sách bài hát -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvQueue"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:clipToPadding="false"
        android:paddingHorizontal="12dp"
        android:paddingBottom="110dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvPlaylistSubtitle" />

    <!-- Thanh điều khiển nổi phía dưới -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="14dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_floating_bottom_bar"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Nhóm: Phát ngẫu nhiên -->
        <LinearLayout
            android:id="@+id/groupShuffle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.5"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnShuffleBottom"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_shuffle"
                app:tint="#A892D8" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Phát ngẫu nhiên"
                android:textColor="#6B4FA8"
                android:textSize="12sp" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="22dp"
            android:layout_marginHorizontal="8dp"
            android:background="#E6D6FF" />

        <!-- Nhóm: Lặp lại -->
        <LinearLayout
            android:id="@+id/groupRepeat"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnRepeatBottom"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_repeat"
                app:tint="#A892D8" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Lặp lại"
                android:textColor="#6B4FA8"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Nút Xóa hàng đợi -->
        <LinearLayout
            android:id="@+id/btnClearQueue"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_clear_queue_btn"
            android:elevation="4dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_clear_all"
                app:tint="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                android:text="Xóa hàng đợi"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>