<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_bottom_sheet_rounded">

    <View
        android:id="@+id/dragHandle"
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_marginTop="12dp"
        android:background="#D1C4E9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- KHU VỰC 1: HEADER BÌNH THƯỜNG -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutNormalHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/layoutSelectionHeader">

        <!-- Đã sửa lại độ rộng để không bị đè lên các nút bên phải -->
        <TextView
            android:id="@+id/tvPlaylistTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:text="Danh sách phát"
            android:textColor="#1F1B2E"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/btnAddSong"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvPlaylistSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="0 bài hát • 0 phút"
            android:textColor="#7A5BA8"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="@id/tvPlaylistTitle"
            app:layout_constraintTop_toBottomOf="@id/tvPlaylistTitle" />

        <!-- Nút Add (Đã căn lại theo chiều dọc với Title) -->
        <ImageView
            android:id="@+id/btnAddSong"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_pill_button_light"
            android:padding="8dp"
            android:src="@drawable/ic_add_purple"
            app:layout_constraintBottom_toBottomOf="@id/tvPlaylistTitle"
            app:layout_constraintEnd_toStartOf="@id/btnMoreOptions"
            app:layout_constraintTop_toTopOf="@id/tvPlaylistTitle"
            app:tint="#7C3AED" />

        <!-- Nút More -->
        <ImageView
            android:id="@+id/btnMoreOptions"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_pill_button_light"
            android:padding="8dp"
            android:src="@drawable/ic_more_vert"
            app:layout_constraintBottom_toBottomOf="@id/tvPlaylistTitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvPlaylistTitle"
            app:tint="#7C3AED" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- THANH CHỌN NHIỀU (nằm TRÊN chữ "Danh sách phát", mặc định ẩn) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutSelectionHeader"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/dragHandle">

        <!-- Bên trái: Tất cả (ĐÃ SỬA LẠI CHO GỌN) -->
        <LinearLayout
            android:id="@+id/btnSelectAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Hiệu ứng chạm được chuyển vào đây, bao phủ vừa vặn nút tròn -->
            <ImageView
                android:id="@+id/ivSelectAllIcon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="4dp"
                android:src="@drawable/ic_check_circle_outline"
                app:tint="#7A5BA8" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Tất cả"
                android:textColor="#1F1B2E"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSelectedCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Đã chọn 0"
            android:textColor="#7A5BA8"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Nút X: thoát chế độ chọn -->
        <ImageView
            android:id="@+id/btnExitSelection"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:src="@drawable/ic_close"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnDeleteSelected"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#1F1B2E" />

        <!-- Bên phải (đối diện): thùng rác đỏ -->
        <ImageView
            android:id="@+id/btnDeleteSelected"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:src="@drawable/ic_delete"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#FF3B30" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Danh sách nhạc -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvQueue"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingBottom="100dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutNormalHeader" />

    <!-- Thanh công cụ nổi dưới cùng (Đã xóa nút Xóa) -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_floating_bottom_bar"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:id="@+id/btnShuffleBottom"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_shuffle"
            app:tint="#9E9E9E" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="Ngẫu nhiên"
            android:textColor="#7A5BA8"
            android:textSize="13sp" />

        <View
            android:layout_width="1dp"
            android:layout_height="20dp"
            android:layout_marginHorizontal="16dp"
            android:background="#E6D6FF" />

        <ImageView
            android:id="@+id/btnRepeatBottom"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_repeat"
            app:tint="#9E9E9E" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="Lặp lại"
            android:textColor="#7A5BA8"
            android:textSize="13sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>