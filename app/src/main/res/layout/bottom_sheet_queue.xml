<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- Ảnh nền (sóng tím, ngôi sao) - code tự căn sát đáy -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/bgImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#F1EAFF"
        android:importantForAccessibility="no"
        android:scaleType="matrix"
        app:shapeAppearanceOverlay="@style/QueueSheetTopRounded"
        android:src="@drawable/bg_queue_sheet"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Lớp kính trắng mờ phía trên -->
    <View
        android:layout_width="0dp"
        android:layout_height="120dp"
        android:background="@drawable/qs_top_glass"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/dragHandle"
        android:layout_width="44dp"
        android:layout_height="4dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/qs_handle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- THANH CHỌN NHIỀU (nằm TRÊN chữ "Danh sách phát", mặc định ẩn) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutSelectionHeader"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/dragHandle">

        <LinearLayout
            android:id="@+id/btnSelectAll"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="16dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/ivSelectAllIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_check_circle_outline"
                app:tint="#7A5BA8" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Tất cả"
                android:textColor="#1F1B2E"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSelectedCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Đã chọn 0"
            android:textColor="#6D28D9"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/btnExitSelection"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_ripple_round"
            android:padding="8dp"
            android:src="@drawable/ic_close"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnDeleteSelected"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#1F1B2E" />

        <ImageView
            android:id="@+id/btnDeleteSelected"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_ripple_round"
            android:padding="8dp"
            android:src="@drawable/ic_delete"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#FF3B30" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- TIÊU ĐỀ -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutNormalHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        app:layout_constraintTop_toBottomOf="@id/layoutSelectionHeader">

        <TextView
            android:id="@+id/tvPlaylistTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="8dp"
            android:maxLines="1"
            android:text="Danh sách phát"
            android:textColor="#1F1B2E"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/btnAddSong"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvPlaylistSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="8dp"
            android:maxLines="1"
            android:text="0 bài hát • 00:00"
            android:textColor="#7A5BA8"
            android:textSize="13sp"
            app:layout_constraintEnd_toStartOf="@id/btnAddSong"
            app:layout_constraintStart_toStartOf="@id/tvPlaylistTitle"
            app:layout_constraintTop_toBottomOf="@id/tvPlaylistTitle" />

        <ImageView
            android:id="@+id/btnAddSong"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/qs_circle_btn"
            android:contentDescription="Thêm nhạc vào danh sách"
            android:padding="8dp"
            android:src="@drawable/ic_q_add_music"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnMoreOptions"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#7C3AED" />

        <ImageView
            android:id="@+id/btnMoreOptions"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/qs_circle_btn"
            android:padding="8dp"
            android:src="@drawable/ic_more_horiz"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#7C3AED" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- DANH SÁCH -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvQueue"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:paddingHorizontal="14dp"
        android:paddingBottom="96dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutNormalHeader" />

    <!-- THANH DƯỚI: Ngẫu nhiên | Lặp lại (hai nửa bằng nhau) -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginHorizontal="14dp"
        android:layout_marginBottom="26dp"
        android:background="@drawable/qs_bottom_bar"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/btnShuffleHolder"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnShuffleBottom"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_shuffle"
                app:tint="#9E9E9E" />

            <TextView
                android:id="@+id/tvShuffleLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="Ngẫu nhiên"
                android:textColor="#7A5BA8"
                android:textSize="15sp" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="26dp"
            android:background="#D9CBF5" />

        <LinearLayout
            android:id="@+id/btnRepeatHolder"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnRepeatBottom"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_repeat"
                app:tint="#9E9E9E" />

            <TextView
                android:id="@+id/tvRepeatLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="Lặp lại"
                android:textColor="#7A5BA8"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
