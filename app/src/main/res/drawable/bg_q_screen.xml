<?xml version="1.0" encoding="utf-8"?>
<!-- Nền toàn màn hình: tím pastel + 2 quầng sáng mờ (góc phải trên, góc trái dưới) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#D9C6FF"
                android:startColor="#F3ECFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.85"
                android:centerY="0.08"
                android:endColor="#00FFFFFF"
                android:gradientRadius="75%p"
                android:startColor="#99FFFFFF"
                android:type="radial" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.1"
                android:centerY="1.0"
                android:endColor="#00B57BFF"
                android:gradientRadius="70%p"
                android:startColor="#66B57BFF"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
