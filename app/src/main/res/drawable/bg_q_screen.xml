<?xml version="1.0" encoding="utf-8"?>
<!-- Nền "aurora": nền tím nhạt + các quầng sáng mềm (hồng, tím, xanh tím) tạo cảm giác hiện đại -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="#EEE4FF"
                android:endColor="#D3C0FF"
                android:startColor="#F8F3FF" />
        </shape>
    </item>
    <!-- quầng tím xanh góc phải trên -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.95"
                android:centerY="0.06"
                android:endColor="#00B79CFF"
                android:gradientRadius="85%p"
                android:startColor="#99B79CFF"
                android:type="radial" />
        </shape>
    </item>
    <!-- quầng hồng giữa trái -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.0"
                android:centerY="0.42"
                android:endColor="#00FFB8EE"
                android:gradientRadius="70%p"
                android:startColor="#80FFB8EE"
                android:type="radial" />
        </shape>
    </item>
    <!-- quầng xanh tím góc phải dưới -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="1.0"
                android:centerY="0.88"
                android:endColor="#007F8CFF"
                android:gradientRadius="80%p"
                android:startColor="#8C7F8CFF"
                android:type="radial" />
        </shape>
    </item>
    <!-- quầng tím đậm góc trái dưới -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.05"
                android:centerY="1.0"
                android:endColor="#00B57BFF"
                android:gradientRadius="75%p"
                android:startColor="#99B57BFF"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
