<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="100dp"
    android:height="100dp"
    android:viewportWidth="100"
    android:viewportHeight="100">

    <!-- Vầng sáng (Glow) phía sau để hòa hợp với nền hồng -->
    <path android:pathData="M50,50m-40,0a40,40 0,1 1,80 0a40,40 0,1 1,-80 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="50" android:centerY="50"
                android:gradientRadius="40"
                android:startColor="#E9D5FF" 
                android:endColor="#00000000" />
        </aapt:attr>
    </path>

    <!-- Mặt trăng khuyết mềm mại -->
    <path android:pathData="M45,15 A 35,35 0 1,0 80,70 A 45,45 0 1,1 45,15 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="20" android:startY="20"
                android:endX="80" android:endY="80"
                android:startColor="#D8B4FE"
                android:endColor="#9333EA"
                android:type="linear" />
        </aapt:attr>
    </path>

    <!-- Vòng hào quang (Orbit) mảnh và sáng -->
    <path
        android:pathData="M15,60 C 20,90 85,85 85,45"
        android:strokeColor="#D8B4FE"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
    
    <!-- Hạt nhỏ trên vòng hào quang -->
    <path android:pathData="M15,60 m-2,0 a2,2 0 1,1 4,0 a2,2 0 1,1 -4,0" android:fillColor="#F3E8FF"/>
    <path android:pathData="M70,80 m-2,0 a2,2 0 1,1 4,0 a2,2 0 1,1 -4,0" android:fillColor="#F3E8FF"/>

    <!-- Nốt nhạc phối màu Gradient bóng bẩy -->
    <path
        android:pathData="M62,30 L62,65 C60,64 56,66 55,70 C54,74 57,78 61,77 C65,76 68,72 68,68 C68,65 66,63 64,62 L64,42 L78,38 L78,60 C76,59 72,61 71,65 C70,69 73,73 77,72 C81,71 84,67 84,63 C84,60 82,58 80,57 L80,28 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="55" android:startY="28"
                android:endX="84" android:endY="78"
                android:startColor="#FFFFFF"
                android:endColor="#A855F7"
                android:type="linear" />
        </aapt:attr>
    </path>

    <!-- Các ngôi sao lấp lánh nhỏ xinh -->
    <path android:pathData="M80,18 L81,24 L87,25 L81,26 L80,32 L79,26 L73,25 L79,24 Z" android:fillColor="#FFFFFF"/>
    <path android:pathData="M25,30 L26,32 L28,33 L26,34 L25,36 L24,34 L22,33 L24,32 Z" android:fillColor="#FFFFFF"/>
    <path android:pathData="M85,75 L86,77 L88,78 L86,79 L85,81 L84,79 L82,78 L84,77 Z" android:fillColor="#FFFFFF"/>

</vector>