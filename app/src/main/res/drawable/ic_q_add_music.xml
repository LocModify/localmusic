<?xml version="1.0" encoding="utf-8"?>
<!-- Icon "thêm nhạc" giống ảnh demo: dấu + đậm bên trái, nốt nhạc đôi (♫) nét dày, xà ngang bo tròn. Tô màu bằng app:tint -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Dấu + (đậm, đầu tròn) -->
    <path
        android:fillColor="#00000000"
        android:pathData="M5,8.4 L5,13.6 M2.4,11 L7.6,11"
        android:strokeColor="#FF000000"
        android:strokeLineCap="round"
        android:strokeWidth="1.9" />
    <!-- Xà ngang (dày, bo tròn góc) -->
    <path
        android:fillColor="#FF000000"
        android:pathData="M12.6,6 L21,5.6 L21,7.6 L12.6,8 Z"
        android:strokeColor="#FF000000"
        android:strokeLineJoin="round"
        android:strokeWidth="1.8" />
    <!-- Hai thân nốt -->
    <path
        android:fillColor="#00000000"
        android:pathData="M12.6,7 L12.6,16.5 M21,6.6 L21,16.5"
        android:strokeColor="#FF000000"
        android:strokeWidth="2.1" />
    <!-- Hai đầu nốt (tròn) -->
    <path
        android:fillColor="#FF000000"
        android:pathData="M7.5,16.9 a3,2.8 0 1,0 6,0 a3,2.8 0 1,0 -6,0 z" />
    <path
        android:fillColor="#FF000000"
        android:pathData="M16.2,16.9 a2.9,2.7 0 1,0 5.8,0 a2.9,2.7 0 1,0 -5.8,0 z" />
</vector>
