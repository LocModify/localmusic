<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Nền trắng ngả tím -->
    <item>
        <shape>
            <solid android:color="#FBFAFF" />
        </shape>
    </item>

    <!-- Mảng tím mờ góc trên trái -->
    <item
        android:width="380dp" android:height="280dp"
        android:gravity="top|start"
        android:top="-120dp" android:left="-150dp">
        <shape android:shape="oval">
            <solid android:color="#40D8C8FB" />
        </shape>
    </item>

    <!-- Mảng tím mờ góc trên phải -->
    <item
        android:width="320dp" android:height="250dp"
        android:gravity="top|end"
        android:top="-110dp" android:right="-120dp">
        <shape android:shape="oval">
            <solid android:color="#33E3D8FD" />
        </shape>
    </item>

    <!-- Mảng tím mờ góc dưới phải -->
    <item
        android:width="340dp" android:height="280dp"
        android:gravity="bottom|end"
        android:bottom="-130dp" android:right="-140dp">
        <shape android:shape="oval">
            <solid android:color="#2ED4C3F9" />
        </shape>
    </item>
</layer-list>