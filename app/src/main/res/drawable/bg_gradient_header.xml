<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Nền gần trắng -->
    <item>
        <shape>
            <solid android:color="#FEFCFF" />
        </shape>
    </item>

    <!-- Mảng tím neon mờ góc trên trái -->
    <item
        android:width="380dp" android:height="280dp"
        android:gravity="top|start"
        android:top="-130dp" android:left="-160dp">
        <shape android:shape="oval">
            <solid android:color="#26B45CFF" />
        </shape>
    </item>

    <!-- Mảng tím neon mờ góc trên phải -->
    <item
        android:width="300dp" android:height="230dp"
        android:gravity="top|end"
        android:top="-120dp" android:right="-130dp">
        <shape android:shape="oval">
            <solid android:color="#1FC77DFF" />
        </shape>
    </item>

    <!-- Mảng tím neon mờ góc dưới phải -->
    <item
        android:width="340dp" android:height="280dp"
        android:gravity="bottom|end"
        android:bottom="-140dp" android:right="-150dp">
        <shape android:shape="oval">
            <solid android:color="#22B45CFF" />
        </shape>
    </item>
</layer-list>