<?xml version="1.0" encoding="utf-8"?>
<!-- Nút Play/Pause: tím neon đậm chuyển màu từ trên xuống, có vệt bóng nhẹ phía trên -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#A56BFF"
                android:endColor="#6D28E8"
                android:type="linear" />
        </shape>
    </item>
    <!-- Vệt sáng bóng kính nửa trên -->
    <item android:left="10dp" android:top="3dp" android:right="10dp" android:bottom="34dp">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#55FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>