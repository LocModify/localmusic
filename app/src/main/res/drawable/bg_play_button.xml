<?xml version="1.0" encoding="utf-8"?>
<!-- Nút Play/Pause: tím neon chuyển màu, viền sáng và vệt bóng kính phía trên -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="315"
                android:startColor="#D3A0FF"
                android:centerColor="#B45CFF"
                android:endColor="#8F3DF0"
                android:type="linear" />
            <stroke android:width="2dp" android:color="#80FFFFFF" />
        </shape>
    </item>
    <!-- Vệt sáng bóng kính nửa trên -->
    <item android:left="12dp" android:top="4dp" android:right="12dp" android:bottom="42dp">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#66FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>