<?xml version="1.0" encoding="utf-8"?>
<!-- Nút kéo: chấm tím neon có viền trắng và vầng sáng mờ -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#33B45CFF" />
            <size android:width="30dp" android:height="30dp" />
        </shape>
    </item>
    <item android:left="6dp" android:top="6dp" android:right="6dp" android:bottom="6dp">
        <shape android:shape="oval">
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
    <item android:left="8dp" android:top="8dp" android:right="8dp" android:bottom="8dp">
        <shape android:shape="oval">
            <gradient
                android:angle="315"
                android:startColor="#D3A0FF"
                android:endColor="#B45CFF" />
        </shape>
    </item>
</layer-list>