<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Nền trắng cơ bản -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
        </shape>
    </item>

    <!-- Lớp sóng 1 (Tím nhạt) -->
    <item android:top="400dp" android:bottom="-150dp" android:left="-100dp" android:right="-100dp">
        <shape android:shape="oval">
            <gradient
                android:startColor="#66D8B4FE"
                android:endColor="#00D8B4FE"
                android:type="radial"
                android:gradientRadius="400dp" />
        </shape>
    </item>

    <!-- Lớp sóng 2 (Tím đậm hơn) -->
    <item android:top="500dp" android:bottom="-200dp" android:left="-150dp" android:right="-150dp">
        <shape android:shape="oval">
            <gradient
                android:startColor="#88C084FC"
                android:endColor="#00C084FC"
                android:type="radial"
                android:gradientRadius="500dp" />
        </shape>
    </item>
</layer-list>