<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 1. Nền trắng cơ bản -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
        </shape>
    </item>

    <!-- 2. Vệt sáng tím mờ ảo góc trên trái -->
    <item android:left="-100dp" android:top="-100dp" android:right="100dp" android:bottom="200dp">
        <shape android:shape="oval">
            <gradient
                android:startColor="#40E9D5FF"
                android:endColor="#00E9D5FF"
                android:type="radial"
                android:gradientRadius="400dp" />
        </shape>
    </item>

    <!-- 3. Vệt sáng hồng nhạt góc trên phải -->
    <item android:left="100dp" android:top="-150dp" android:right="-100dp" android:bottom="100dp">
        <shape android:shape="oval">
            <gradient
                android:startColor="#30F3E8FF"
                android:endColor="#00F3E8FF"
                android:type="radial"
                android:gradientRadius="350dp" />
        </shape>
    </item>

    <!-- 4. Dải sóng mờ uốn lượn dưới đáy màn hình -->
    <item android:left="-150dp" android:top="450dp" android:right="-150dp" android:bottom="-150dp">
        <shape android:shape="oval">
            <gradient
                android:startColor="#50D8B4FE"
                android:endColor="#00D8B4FE"
                android:type="radial"
                android:gradientRadius="500dp" />
        </shape>
    </item>
</layer-list>