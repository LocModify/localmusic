<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Nền trắng tinh khiết -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
        </shape>
    </item>

    <!-- Mảng màu tím nhạt mờ ở góc trên bên trái -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="60%p"
                android:startColor="#40DCC6FF"
                android:endColor="#00DCC6FF" />
        </shape>
    </item>

    <!-- Mảng màu xanh nhạt mờ ở góc dưới bên phải -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="60%p"
                android:startColor="#30E0F7FA"
                android:endColor="#00E0F7FA" />
        </shape>
    </item>

    <!-- Mảng màu tím nhạt thứ 2 ở dưới cùng bên trái -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="50%p"
                android:startColor="#30F3E5F5"
                android:endColor="#00F3E5F5" />
        </shape>
    </item>
</layer-list>