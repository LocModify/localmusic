<?xml version="1.0" encoding="utf-8"?>
<!-- Nền Now Playing: trắng chuyển lavender rất nhạt + lớp sóng/lụa tím phía trên -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#FFFFFF"
                android:endColor="#F8F2FF"
                android:type="linear" />
        </shape>
    </item>
    <item android:drawable="@drawable/bg_waves" />
</layer-list>