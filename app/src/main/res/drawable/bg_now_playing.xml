<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Nền trắng cơ bản -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FAFAFF" />
        </shape>
    </item>

    <!-- Mây tím nhạt góc trên trái -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="350dp"
                android:centerX="0.1"
                android:centerY="0.1"
                android:startColor="#80E8D5FF"
                android:endColor="#00FAFAFF" />
        </shape>
    </item>

    <!-- Mây xanh nhạt góc trên phải -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="350dp"
                android:centerX="0.9"
                android:centerY="0.15"
                android:startColor="#70D5EEFF"
                android:endColor="#00FAFAFF" />
        </shape>
    </item>

    <!-- Mây hồng nhạt góc dưới trái -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="350dp"
                android:centerX="0.1"
                android:centerY="0.9"
                android:startColor="#70FFE5F1"
                android:endColor="#00FAFAFF" />
        </shape>
    </item>

    <!-- Mây tím đậm góc dưới phải -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="400dp"
                android:centerX="0.9"
                android:centerY="0.85"
                android:startColor="#80DCC6FF"
                android:endColor="#00FAFAFF" />
        </shape>
    </item>
</layer-list>