<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Nền trắng cơ bản -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FAFAFF" />
        </shape>
    </item>

    <!-- Mảng mây tím nhạt góc trên trái -->
    <item android:top="-10%p" android:left="-20%p">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="80%p"
                android:startColor="#60E8D5FF"
                android:endColor="#00E8D5FF" />
        </shape>
    </item>

    <!-- Mảng mây xanh nhạt góc trên phải -->
    <item android:top="-15%p" android:right="-20%p">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="80%p"
                android:startColor="#50D5EEFF"
                android:endColor="#00D5EEFF" />
        </shape>
    </item>

    <!-- Mảng mây hồng nhạt góc dưới trái -->
    <item android:bottom="-20%p" android:left="-10%p">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="80%p"
                android:startColor="#60FFE5F1"
                android:endColor="#00FFE5F1" />
        </shape>
    </item>

    <!-- Mảng mây tím đậm hơn góc dưới phải -->
    <item android:bottom="-15%p" android:right="-20%p">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="70%p"
                android:startColor="#50DCC6FF"
                android:endColor="#00DCC6FF" />
        </shape>
    </item>
</layer-list>