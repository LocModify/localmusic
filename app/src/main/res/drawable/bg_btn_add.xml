<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bóng đổ đều 4 phía -->
    <item android:left="2dp" android:top="3dp" android:right="2dp" android:bottom="1dp">
        <shape android:shape="oval">
            <solid android:color="#338B5CF6" />
        </shape>
    </item>
    
    <!-- Nền chính Gradient -->
    <item android:bottom="3dp" android:top="1dp" android:left="1dp" android:right="1dp">
        <shape android:shape="oval">
            <gradient
                android:startColor="#FFFFFF"
                android:centerColor="#F5EDFF"
                android:endColor="#E9D5FF"
                android:angle="270" />
            <stroke android:width="1dp" android:color="#E9D5FF"/>
        </shape>
    </item>
</layer-list>