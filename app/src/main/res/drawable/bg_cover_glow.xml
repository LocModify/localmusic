<?xml version="1.0" encoding="utf-8"?>
<!-- Vầng sáng tím tỏa quanh ảnh bìa: nhiều lớp oval chồng nhau, càng vào trong càng đậm -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
