    <item android:left="14dp" android:top="14dp" android:right="14dp" android:bottom="14dp">
        <shape android:shape="oval">
            <solid android:color="#26B45CFF" />
        </shape>
    </item>
    <item android:left="19dp" android:top="19dp" android:right="19dp" android:bottom="19dp">
        <shape android:shape="oval">
            <solid android:color="#38B45CFF" />
        </shape>
    </item>
    <item android:left="22dp" android:top="22dp" android:right="22dp" android:bottom="22dp">
        <shape android:shape="oval">
            <solid android:color="#4DB45CFF" />
        </shape>
    </item>
</layer-list>